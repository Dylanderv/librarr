TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Token protégeant l'API du sidecar (header X-Api-Key). À partager avec Librarr.
TELEGRAM_SIDECAR_API_KEY=change-me
TELEGRAM_SESSION_PATH=/data/telegram/session
TELEGRAM_DB_PATH=/data/telegram/queue.db
# Staging : les downloads atterrissent ici, puis sont déplacés vers une
# bibliothèque (bd_dir / ebook_dir / audiobook_dir / manga_dir) via l'interface.
DOWNLOAD_DIR=/downloads
# Dossiers de bibliothèque (doivent matcher les volumes partagés avec Librarr).
EBOOK_DIR=/books/ebooks
AUDIOBOOK_DIR=/books/audiobooks
MANGA_DIR=/books/manga
BD_DIR=/books/bd
# Garde-fous
MAX_FILE_BYTES=2000000000
POLL_INTERVAL_SECONDS=2
