{
  "openapi": "3.1.0",
  "info": {
    "title": "Librarr API",
    "description": "Self-hosted book, audiobook, and manga search and download manager — the *arr for books. The HTTP/JSON API powers both the SPA and any external tooling (CLI scripts, AI agents, *arr-family integrations).",
    "version": "1.x",
    "license": {"name": "MIT", "identifier": "MIT"}
  },
  "servers": [
    {"url": "http://localhost:5050", "description": "Default local install"}
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "API key for programmatic access. Also accepted via ?apikey= query parameter."
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "librarr_session",
        "description": "Set by POST /api/login. Used by the SPA."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": {"type": "boolean", "enum": [false]},
          "error":   {"type": "string"}
        }
      },
      "SearchResult": {
        "type": "object",
        "description": "A single search hit. Fields are populated per driver — direct-download drivers omit seeders/leechers; torrent drivers usually omit MD5.",
        "properties": {
          "title":        {"type": "string"},
          "author":       {"type": "string"},
          "source":       {"type": "string", "description": "Driver identifier (e.g. annas, gutenberg, prowlarr)."},
          "size":         {"type": "integer", "format": "int64"},
          "size_human":   {"type": "string"},
          "seeders":      {"type": "integer"},
          "leechers":     {"type": "integer"},
          "magnet_url":   {"type": "string"},
          "download_url": {"type": "string", "format": "uri"},
          "md5":          {"type": "string"},
          "info_hash":    {"type": "string"},
          "url":          {"type": "string", "format": "uri"},
          "cover_url":    {"type": "string", "format": "uri"},
          "format":       {"type": "string", "description": "epub, pdf, mobi, mp3, m4b, cbz, etc."},
          "score":        {"type": "integer", "description": "0-100 confidence score."},
          "media_type":   {"type": "string", "enum": ["ebook", "audiobook", "manga"]}
        }
      },
      "WishlistItem": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "id":         {"type": "integer", "format": "int64"},
          "title":      {"type": "string"},
          "author":     {"type": "string"},
          "media_type": {"type": "string", "enum": ["ebook", "audiobook", "manga"]}
        }
      },
      "FileMetadataFields": {
        "type": "object",
        "description": "Metadata of one file as read from its ComicInfo.xml (CBZ) or OPF (EPUB). Absent and empty are the same thing here.",
        "properties": {
          "title":        {"type": "string"},
          "series":       {"type": "string"},
          "series_index": {"type": "string"},
          "summary":      {"type": "string"},
          "publisher":    {"type": "string"},
          "language":     {"type": "string"},
          "isbn":         {"type": "string"},
          "authors":      {"type": "array", "items": {"type": "string"}},
          "genres":       {"type": "array", "items": {"type": "string"}},
          "tags":         {"type": "array", "items": {"type": "string"}}
        }
      },
      "FileMetadataRequest": {
        "type": "object",
        "description": "Payload shared by /api/files/metadata/preview and /api/files/metadata/apply — applying is 'preview again, then act', not a second code path.",
        "required": ["path", "fields"],
        "properties": {
          "path":      {"type": "string", "description": "Absolute path of a file or a folder under a library root"},
          "recursive": {"type": "boolean", "default": false, "description": "Folders only: also cover subfolders"},
          "mode":      {"type": "string", "enum": ["set", "append"], "default": "set", "description": "Only affects the list fields (authors, genres, tags); scalars are always replaced"},
          "fields":    {"allOf": [{"$ref": "#/components/schemas/FileMetadataFields"}], "description": "Only the fields present are written. title, series_index and isbn identify a single volume and are refused when path is a folder."}
        }
      },
      "PaginatedList": {
        "type": "object",
        "description": "Standard list response shape used across /api/library, /api/activity, etc.",
        "properties": {
          "items":  {"type": "array", "items": {"type": "object"}},
          "total":  {"type": "integer"},
          "limit":  {"type": "integer"},
          "offset": {"type": "integer"}
        }
      }
    }
  },
  "security": [{"apiKey": []}, {"session": []}],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "description": "Liveness probe. Returns 200 if the binary is running. No auth required.",
        "security": [],
        "responses": {"200": {"description": "OK"}}
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This OpenAPI spec",
        "description": "Returns this OpenAPI 3.1 document. AI agents can fetch this to discover endpoints.",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {"application/json": {"schema": {"type": "object"}}}
          }
        }
      }
    },
    "/api/auth/status": {
      "get": {"summary": "Current auth state"}
    },
    "/api/login":  {"post": {"summary": "Session login", "security": []}},
    "/api/login/totp": {"post": {"summary": "TOTP 2FA verification step", "security": []}},
    "/api/logout": {"post": {"summary": "End session"}},
    "/api/register": {"post": {"summary": "Register new user (requires invite code when configured)", "security": []}},

    "/api/search": {
      "get": {
        "summary": "Search ebooks across all configured sources",
        "parameters": [
          {"name": "q",      "in": "query", "required": true,  "schema": {"type": "string"}, "description": "Search query."},
          {"name": "author", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results":        {"type": "array", "items": {"$ref": "#/components/schemas/SearchResult"}},
                    "search_time_ms": {"type": "integer"},
                    "sources":        {"type": "array", "items": {"type": "object"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/search/audiobooks": {
      "get": {
        "summary": "Search audiobooks",
        "parameters": [
          {"name": "q",      "in": "query", "required": true,  "schema": {"type": "string"}},
          {"name": "author", "in": "query", "required": false, "schema": {"type": "string"}}
        ]
      }
    },
    "/api/search/manga": {
      "get": {
        "summary": "Search manga",
        "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string"}}]
      }
    },

    "/api/sources": {
      "get": {
        "summary": "List configured search sources + health",
        "description": "Returns each registered driver with enabled state, circuit-breaker status, last success/fail counters. Useful for AI agents debugging why a source isn't returning results."
      }
    },

    "/api/library": {
      "get": {
        "summary": "List ebooks in the library",
        "parameters": [
          {"name": "limit",  "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 50}},
          {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}},
          {"name": "type",   "in": "query", "schema": {"type": "string", "enum": ["ebook", "audiobook", "manga"]}},
          {"name": "tag",    "in": "query", "schema": {"type": "string"}, "description": "Filter by tag name."}
        ],
        "responses": {
          "200": {
            "description": "Paginated library items",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PaginatedList"}}}
          }
        }
      }
    },
    "/api/library/audiobooks": {"get": {"summary": "List audiobooks (proxied from Audiobookshelf when configured)"}},
    "/api/library/manga":      {"get": {"summary": "List manga"}},
    "/api/library/manga/series/{id}/metadata": {"get": {"summary": "Get a Kavita series' current metadata (admin; for pre-filling the bulk editor)", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}]}},
    "/api/library/metadata/bulk": {"post": {"summary": "Bulk-write metadata into the files of the selected Kavita series (EPUB OPF / CBZ ComicInfo.xml), then rescan (admin)", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["series_ids"], "properties": {"series_ids": {"type": "array", "items": {"type": "integer"}}, "mode": {"type": "string", "enum": ["set", "append"], "description": "How authors/genres/tags lists are applied"}, "fields": {"type": "object", "properties": {"title": {"type": "string"}, "series": {"type": "string"}, "series_index": {"type": "string"}, "summary": {"type": "string"}, "publisher": {"type": "string"}, "language": {"type": "string"}, "isbn": {"type": "string"}, "authors": {"type": "array", "items": {"type": "string"}}, "genres": {"type": "array", "items": {"type": "string"}}, "tags": {"type": "array", "items": {"type": "string"}}}}, "rename": {"type": "string", "enum": ["none", "folder", "folder_and_files"], "default": "none", "description": "Realign folder/file names with the series field being written; requires fields.series"}}}}}}}},
    "/api/library/metadata/rename-preview": {"post": {"summary": "Preview the folder/file renames a bulk metadata edit would perform, without touching anything (admin)", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["series_ids", "series_name"], "properties": {"series_ids": {"type": "array", "items": {"type": "integer"}}, "series_name": {"type": "string"}, "mode": {"type": "string", "enum": ["none", "folder", "folder_and_files"]}}}}}}, "responses": {"200": {"description": "Planned changes", "content": {"application/json": {"schema": {"type": "object", "properties": {"plans": {"type": "array", "items": {"type": "object", "properties": {"series_id": {"type": "integer"}, "series_name": {"type": "string"}, "folder_from": {"type": "string"}, "folder_to": {"type": "string"}, "files": {"type": "array", "items": {"type": "object", "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}}, "skipped": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}, "errors": {"type": "array", "items": {"type": "string"}}}}}}}}}}}}},
    "/api/metadata/search": {"get": {"summary": "Search an online metadata source (AniList for manga, Open Library for books) for candidates to pre-fill the bulk editor (admin)", "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string"}}, {"name": "type", "in": "query", "required": false, "schema": {"type": "string", "enum": ["manga", "book"], "default": "manga"}}], "responses": {"200": {"description": "Candidate matches", "content": {"application/json": {"schema": {"type": "object", "properties": {"candidates": {"type": "array", "items": {"type": "object", "properties": {"source": {"type": "string"}, "title": {"type": "string"}, "summary": {"type": "string"}, "authors": {"type": "array", "items": {"type": "string"}}, "genres": {"type": "array", "items": {"type": "string"}}, "tags": {"type": "array", "items": {"type": "string"}}, "year": {"type": "string"}, "publisher": {"type": "string"}, "language": {"type": "string"}, "cover_url": {"type": "string"}, "site_url": {"type": "string"}}}}}}}}}}}},
    "/api/library/book/{id}":      {"delete": {"summary": "Remove an ebook from the library", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}]}},
    "/api/library/audiobook/{id}": {"delete": {"summary": "Remove an audiobook", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}]}},
    "/api/library/{id}/tags":      {"get":  {"summary": "List tags for a library item"}, "post": {"summary": "Add a tag to a library item"}},
    "/api/library/{id}/tags/{tagId}": {"delete": {"summary": "Remove a tag from a library item"}},

    "/api/files/roots": {
      "get": {
        "summary": "List the browsable library roots — MANGA_DIR / EBOOK_DIR / AUDIOBOOK_DIR, keeping only directories that exist (admin)",
        "description": "Entry point of the /api/files/* surface, which browses the filesystem directly and never queries Kavita. Every other /api/files/* path takes an absolute path that must sit under one of these roots.",
        "responses": {
          "200": {"description": "Configured libraries", "content": {"application/json": {"schema": {"type": "object", "properties": {"roots": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "enum": ["manga", "ebooks", "audiobooks"]}, "label": {"type": "string"}, "path": {"type": "string", "description": "Absolute path with symlinks resolved"}}}}, "kavita": {"type": "boolean", "description": "Whether POST /api/files/kavita/scan is usable on this instance"}}}}}}
        }
      }
    },
    "/api/files/list": {
      "get": {
        "summary": "List one directory of one library — a single non-recursive ReadDir (admin)",
        "description": "Cached in memory for ~30s and invalidated for any folder librarr writes to. No archive is opened: metadata is read on demand through /api/files/metadata.",
        "parameters": [{"name": "path", "in": "query", "required": true, "schema": {"type": "string"}, "description": "Absolute path of a directory under a library root"}],
        "responses": {
          "200": {"description": "Directory listing", "content": {"application/json": {"schema": {"type": "object", "properties": {"root": {"type": "string"}, "root_label": {"type": "string"}, "root_path": {"type": "string"}, "path": {"type": "string"}, "is_root": {"type": "boolean"}, "parent": {"type": "string", "description": "Empty on a library root"}, "segments": {"type": "array", "description": "Breadcrumb below the root", "items": {"type": "object", "properties": {"name": {"type": "string"}, "path": {"type": "string"}}}}, "entries": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "is_dir": {"type": "boolean"}, "size": {"type": "integer"}, "modified": {"type": "string", "format": "date-time"}, "kind": {"type": "string", "enum": ["cbz", "epub", "pdf", "cbr", "audio", "other"], "description": "Empty for directories"}, "editable": {"type": "boolean", "description": "librarr can write metadata into it (CBZ and EPUB only)"}}}}}}}}},
          "400": {"description": "Path missing, relative, or not a directory"},
          "403": {"description": "Path outside the configured libraries"},
          "404": {"description": "Directory not found"},
          "503": {"description": "No library directory is configured"}
        }
      }
    },
    "/api/files/rename/preview": {
      "post": {
        "summary": "Preview the renaming of a folder and its files, without touching anything (admin)",
        "description": "Every file of the folder is returned, including those that will not move, so nothing is silently left out. A volume number is never guessed: a file with no detected and no supplied number comes back with status no_volume and is skipped.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["path", "series_name", "mode"], "properties": {"path": {"type": "string", "description": "Absolute path of the folder, never a bare library root"}, "series_name": {"type": "string", "description": "Target series name; the UI pre-fills it with the current folder name"}, "mode": {"type": "string", "enum": ["folder", "folder_and_files"], "description": "Required: an absent or none mode is refused with 400"}, "volumes": {"type": "object", "description": "Manual volume numbers keyed by the file's current base name; overrides detection", "additionalProperties": {"type": "integer"}}}}}}},
        "responses": {
          "200": {"description": "Planned renames", "content": {"application/json": {"schema": {"type": "object", "properties": {"path": {"type": "string"}, "series_name": {"type": "string"}, "mode": {"type": "string"}, "folder_from": {"type": "string"}, "folder_to": {"type": "string"}, "files": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "kind": {"type": "string"}, "editable": {"type": "boolean"}, "volume": {"type": "integer"}, "volume_source": {"type": "string", "enum": ["manual", "detected", "none"]}, "target": {"type": "string"}, "status": {"type": "string", "enum": ["rename", "unchanged", "no_volume", "collision", "folder_only"]}}}}, "warnings": {"type": "array", "items": {"type": "string"}}}}}}},
          "400": {"description": "Invalid JSON body, missing series name, missing or unknown rename mode, or path is not a directory"},
          "403": {"description": "Path outside the libraries, or a bare library root"},
          "404": {"description": "Folder not found"},
          "503": {"description": "No library directory is configured"}
        }
      }
    },
    "/api/files/rename/apply": {
      "post": {
        "summary": "Apply the folder/file renaming (admin)",
        "description": "Same payload as /api/files/rename/preview. The plan is always recomputed server-side from the payload — a plan sent by the client is never applied. If the folder itself cannot be moved, its files are still renamed in place.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["path", "series_name", "mode"], "properties": {"path": {"type": "string"}, "series_name": {"type": "string"}, "mode": {"type": "string", "enum": ["folder", "folder_and_files"]}, "volumes": {"type": "object", "additionalProperties": {"type": "integer"}}}}}}},
        "responses": {
          "200": {"description": "Result; per-file failures are collected in errors rather than aborting the batch", "content": {"application/json": {"schema": {"type": "object", "properties": {"path": {"type": "string", "description": "Where the folder now lives, to reopen the listing on"}, "renamed": {"type": "integer"}, "errors": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}}}}}},
          "400": {"description": "Invalid JSON body, missing series name, missing or unknown rename mode, or path is not a directory"},
          "403": {"description": "Path outside the libraries, or a bare library root"},
          "404": {"description": "Folder not found"},
          "503": {"description": "No library directory is configured"}
        }
      }
    },
    "/api/files/rename/file": {
      "post": {
        "summary": "Rename a single file to a free-form name (admin)",
        "description": "The name is sanitized and the original extension is always kept: a typed \"Berserk.exe\" on a .cbz becomes \"Berserk.exe.cbz\" rather than a file Kavita can no longer read.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["path", "new_name"], "properties": {"path": {"type": "string", "description": "Absolute path of the file"}, "new_name": {"type": "string", "description": "New name, with or without the extension"}}}}}},
        "responses": {
          "200": {"description": "Renamed", "content": {"application/json": {"schema": {"type": "object", "properties": {"path": {"type": "string"}, "name": {"type": "string"}}}}}},
          "400": {"description": "Invalid JSON body, empty name, unchanged name, or path is a directory"},
          "403": {"description": "Path outside the libraries, or a bare library root"},
          "404": {"description": "File not found"},
          "409": {"description": "A file already has the target name"},
          "503": {"description": "No library directory is configured"}
        }
      }
    },
    "/api/files/metadata": {
      "get": {
        "summary": "Read the metadata one file currently holds (admin)",
        "description": "Opens the archive, so it is meant to be called when a file panel is opened, not for every row of a listing. A non-editable format (PDF, CBR, audio) answers 200 with editable=false and a reason key rather than an error.",
        "parameters": [{"name": "path", "in": "query", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Current metadata", "content": {"application/json": {"schema": {"type": "object", "properties": {"path": {"type": "string"}, "name": {"type": "string"}, "kind": {"type": "string"}, "editable": {"type": "boolean"}, "reason": {"type": "string", "enum": ["pdf_ignored_by_kavita", "cbr_rar_archive", "audio_unsupported", "format_unsupported"], "description": "Present only when editable is false"}, "fields": {"$ref": "#/components/schemas/FileMetadataFields"}}}}}},
          "400": {"description": "Path missing, relative, or path is a directory"},
          "403": {"description": "Path outside the configured libraries"},
          "404": {"description": "File not found"},
          "503": {"description": "No library directory is configured"}
        }
      }
    },
    "/api/files/metadata/preview": {
      "post": {
        "summary": "Show what a metadata edit would change, file by file, without writing (admin)",
        "description": "Values are replaced, not merged (mode append only concerns the list fields), so the preview is what makes the overwrite visible before it happens. title, series_index and isbn identify a single volume and are rejected when path is a directory. At most 500 files are inspected; beyond that truncated is true.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FileMetadataRequest"}}}},
        "responses": {
          "200": {"description": "Per-file diff", "content": {"application/json": {"schema": {"type": "object", "properties": {"path": {"type": "string"}, "is_dir": {"type": "boolean"}, "recursive": {"type": "boolean"}, "files": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "path": {"type": "string"}, "kind": {"type": "string"}, "editable": {"type": "boolean"}, "status": {"type": "string"}, "reason": {"type": "string"}, "error": {"type": "string"}, "changes": {"type": "array", "items": {"type": "object", "properties": {"field": {"type": "string"}, "current": {"type": "string"}, "target": {"type": "string"}, "changed": {"type": "boolean"}}}}}}}, "inspected": {"type": "integer"}, "limit": {"type": "integer"}, "truncated": {"type": "boolean"}, "notices": {"type": "array", "description": "Informational outcomes, never failures", "items": {"type": "object", "properties": {"key": {"type": "string"}, "count": {"type": "integer"}}}}, "errors": {"type": "array", "items": {"type": "string"}}}}}}},
          "400": {"description": "Invalid JSON body, no field supplied, or a per-volume field (title, series_index, isbn) targeted at a directory"},
          "403": {"description": "Path outside the libraries, or a bare library root"},
          "404": {"description": "Path not found"},
          "503": {"description": "No library directory is configured"}
        }
      }
    },
    "/api/files/metadata/apply": {
      "post": {
        "summary": "Write metadata into a file, or into every file of a folder (admin)",
        "description": "Same payload as /api/files/metadata/preview, recomputed server-side. CBZ get a patched ComicInfo.xml, EPUB a patched OPF; unsupported formats are counted, not failed. A file that fails does not stop the batch — its error is collected.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FileMetadataRequest"}}}},
        "responses": {
          "200": {"description": "Result", "content": {"application/json": {"schema": {"type": "object", "properties": {"path": {"type": "string"}, "written": {"type": "integer"}, "unchanged": {"type": "integer"}, "unsupported": {"type": "integer"}, "inspected": {"type": "integer"}, "limit": {"type": "integer"}, "truncated": {"type": "boolean"}, "notices": {"type": "array", "items": {"type": "object", "properties": {"key": {"type": "string"}, "count": {"type": "integer"}}}}, "errors": {"type": "array", "items": {"type": "string"}}}}}}},
          "400": {"description": "Invalid JSON body, no field supplied, or a per-volume field targeted at a directory"},
          "403": {"description": "Path outside the libraries, or a bare library root"},
          "404": {"description": "Path not found"},
          "503": {"description": "No library directory is configured"}
        }
      }
    },
    "/api/files/kavita/scan": {
      "post": {
        "summary": "Ask Kavita to rescan its libraries (admin)",
        "description": "Manual only: no rename or metadata write triggers a scan, so a session of many small edits costs one scan instead of one per edit. SCOPE: the scan is targeted. librarr lists Kavita's libraries, translates each library's folders back to local paths through KAVITA_PATH_MAP, and scans those that overlap the requested root (in either direction — a Kavita library may sit under the root or contain it). Libraries are never matched by name. Several libraries can match one root and all of them are scanned; when none match, the request fails with 409 and a detail naming the local root and the Kavita paths compared.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["root"], "properties": {"root": {"type": "string", "enum": ["manga", "ebooks", "audiobooks"]}}}}}},
        "responses": {
          "200": {"description": "Scan requested", "content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"type": "string", "enum": ["requested"]}, "root": {"type": "string"}, "libraries": {"type": "array", "description": "The Kavita libraries actually scanned", "items": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}}}}}}}},
          "400": {"description": "Invalid JSON body or missing root"},
          "404": {"description": "Unknown library root"},
          "409": {"description": "No Kavita library maps to this root; detail names the local root and the Kavita paths compared", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean"}, "error": {"type": "string"}, "detail": {"type": "string"}}}}}},
          "502": {"description": "Kavita refused or could not be reached; detail carries Kavita's HTTP status and reason, never an internal URL or token", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean"}, "error": {"type": "string"}, "detail": {"type": "string"}}}}}},
          "503": {"description": "Kavita is not configured, or no library directory is configured"}
        }
      }
    },

